---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import ogSource from "../assets/teams/vikings/group-shot.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroHolly from "../assets/hero/hero-holly-jamming.jpg";
import heroSass from "../assets/hero/hero-sass-jamming.jpg";
import heroWall from "../assets/hero/hero-bombshells-wall.jpg";
import heroPack from "../assets/hero/hero-vikings-pack.jpg";

// Hero carousel. `position` is the object-position focal point, which
// matters on desktop where the right half of the hero crops each photo
// to a tall frame. All photos by Darren Stehr (credited on the carousel).
const heroSlides = [
    {
        src: heroHolly,
        alt: "Bombshell Battalion jammer Holly, number 104, pushes past a Nickel City blocker",
        position: "object-[62%_50%]",
    },
    {
        src: heroSass,
        alt: "Bombshell Battalion jammer Sass fights her way past an opposing blocker",
        position: "object-left",
    },
    {
        src: heroWall,
        alt: "Bombshell Battalion blockers brace shoulder to shoulder against an opposing jammer",
        position: "object-[40%_50%]",
    },
    {
        src: heroPack,
        alt: "Striking Vikings skaters battle for position in the pack",
        position: "object-[30%_50%]",
    },
];

// 1200×630 Open Graph image for link previews, cropped from a team photo.
const ogImage = await getImage({
    src: ogSource,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "jpg",
});

const allGames = await getCollection("games");

// Get today's date at midnight for an accurate comparison
const today = new Date();
today.setHours(0, 0, 0, 0);

// Filter for future games and sort by date (closest first)
const upcomingGame = allGames
    .filter((game) => new Date(game.data.date) >= today)
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())[0]; // Take only the first one

const rawSections = await getCollection("homepage");
const sortedSections = rawSections.sort((a, b) => a.id.localeCompare(b.id));

const sections = await Promise.all(
    sortedSections.map(async (section) => {
        const { Content } = await render(section);
        return { ...section, Content };
    }),
);

// Fetch the homepage settings singleton
const settingsEntries = await getCollection("homepageSettings");
let AboutContent;
let settings;

if (settingsEntries.length > 0) {
    const entry = settingsEntries[0];
    const { Content } = await render(entry);
    AboutContent = Content;
    settings = entry.data;
} else {
    // We define a fallback *only if needed* or handle it in the template
    settings = {
            hero_heading: 'Welcome to Renegade Derby',
	        hero_tagline: 'Your source for all things roller derby.',
	        hero_cta_primary_label: 'Learn More',
	        hero_cta_primary_url: '#',
	        hero_cta_secondary_label: 'Curious To Join?',
	        hero_cta_secondary_url: '#',
	        about_eyebrow: 'About Us',
	        about_heading: 'What is Roller Derby?',
	        about_cta_label: 'Read More',
	        about_cta_url: '#',
    }; // <--- Close the object
    } // <--- Close the else block
---

<BaseLayout
    ogImage={new URL(ogImage.src, Astro.site).href}
    title="Simcoe County Flat-Track Roller Derby"
    description="Renegade Derby Dames is Simcoe County's first flat-track roller derby league, founded in 2011. See our next home game, meet the teams, and find out how to join."
>
    <section class="relative overflow-hidden z-0 pt">
        <div class="mx-auto max-w-7xl">
            <div class="relative z-10 lg:w-full lg:max-w-2xl">
                <svg
                    class="absolute inset-y-0 right-8 hidden h-full w-80 translate-x-1/2 transform fill-base-100 lg:block"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                >
                    <polygon points="0,0 90,0 50,100 0,100"></polygon>
                </svg>

                <div
                    class="relative px-6 py-10 sm:py-10 xs:py-10 lg:py-40 lg:px-8 lg:pr-0"
                >
                    <div class="mx-auto max-w-4xl lg:mx-0 lg:max-w-xl">
                        {
                            upcomingGame && (
                                <div class="mb-10 sm:flex">
                                    <a
                                        href="/games"
                                        class="relative rounded-full px-8 py-2 text-sm/6 ring-1 ring-accent hover:ring-secondary transition-all group block"
                                    >
                                        <div class="mx-auto max-w-7xl">
                                            <p class="text-secondary uppercase tracking-widest font-black ">
                                                Upcoming Game:
                                            </p>
                                            <div class="flex items-baseline gap-4">
                                                <p class="font-bold text-bright whitespace-nowrap">
                                                    {upcomingGame.data.date.toLocaleDateString(
                                                        "en-US",
                                                        {
                                                            month: "short",
                                                            day: "numeric",
                                                            timeZone: "UTC",
                                                        },
                                                    )}
                                                </p>
                                                <span class="text-bright/20">
                                                    |
                                                </span>
                                                <p class="font-black uppercase  text-bright group-hover:text-secondary transition-colors">
                                                    {
                                                        upcomingGame.data
                                                            .entries[0]?.title
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            )
                        }
                        <h1
                            class="text-6xl font-semibold text-pretty sm:text-7xl/22 text-bright uppercase"
                        >
                            {settings.hero_heading}
                        </h1>
                        <p
                            class="mt-8 text-lg font-medium text-pretty sm:text-xl/8"
                        >
                            {settings.hero_tagline}
                        </p>
                        <div class="mt-10 flex items-center gap-x-6">
                            <a href={settings.hero_cta_primary_url} class="btn btn-secondary"
                                >{settings.hero_cta_primary_label}</a
                            >
                            <a
                                href={settings.hero_cta_secondary_url}
                                class="btn btn-accent btn-outline text-accent"
                                >{settings.hero_cta_secondary_label}</a
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div
            class="relative aspect-4/3 w-full lg:absolute lg:inset-y-0 lg:right-0 lg:aspect-auto lg:w-1/2"
        >
            <div class="carousel h-full w-full">
                {
                    heroSlides.map((slide, i) => (
                        <div class="carousel-item h-full w-full">
                            <Image
                                src={slide.src}
                                alt={slide.alt}
                                widths={[640, 960, 1280, 1920]}
                                sizes="(min-width: 1024px) 50vw, 100vw"
                                loading={i === 0 ? "eager" : "lazy"}
                                fetchpriority={i === 0 ? "high" : "auto"}
                                class={`h-full w-full object-cover ${slide.position}`}
                            />
                        </div>
                    ))
                }
            </div>
            <p
                class="absolute right-3 bottom-2 rounded bg-base-100/60 px-2 py-0.5 text-xs text-base-content"
            >
                Photos: Darren Stehr
            </p>
        </div>
    </section>

    <section class="overflow-hidden bg-base-300">
        <div
            class="mx-auto max-w-4xl px-6 lg:flex lg:px-8 lg:py-12 sm:py-9 py-9 justify-items-center"
        >
            <div
                class="grid grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:grid-cols-2 lg:items-start"
            >
                <div class="sm:px-6 lg:px-0">
                    <span class="text-base/6 font-semibold text-accent"
                        >{settings.about_eyebrow}
                    </span>
                    <h2
                        class="mt-2 text-4xl/12 font-semibold text-pretty sm:text-5xl/14 text-bright uppercase mb-8"
                    >
                        {settings.about_heading}
                    </h2>
                    <a href={settings.about_cta_url} class="btn btn-secondary">{settings.about_cta_label}</a>
                </div>

                <div class="sm:px-6 lg:px-6">
                    <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-lg">
                        <div class="ext-lg/8 mt-8 prose prose-invert">
                            {AboutContent ? (
                                <AboutContent />
                            ) : (
                                <p>No about content found.</p>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="space-y-24 py-24">
        {
            sections.map((section, index) => (
                <section class="mx-auto max-w-4xl px-6 lg:flex lg:px-8 lg:py-12 sm:py-9 py-9 justify-items-center">
                    <div
                        class={`flex flex-col gap-12 lg:items-center ${index % 2 === 1 ? "lg:flex-row-reverse" : "lg:flex-row"}`}
                    >
                        {/* Image Side */}
                        <div class="w-full lg:w-1/4">
                            <Image
                                src={section.data.sectionImage}
                                alt={section.data.title}
                                class="rounded-2xl object-cover"
                                width={800}
                            />
                        </div>

                        {/* Text Side */}
                        <div class="w-full lg:w-3/4 prose prose-invert prose-lg">
                            <h3 class="mt-2 text-2xl font-semibold text-pretty sm:text-4xl text-bright">
                                {section.data.title}
                            </h3>
                            <section.Content />
                        </div>
                    </div>
                </section>
                <hr class="border-t border-base-content/30 mx-auto max-w-7xl mt-12 mb-12" />
            ))
        }
    </section>


</BaseLayout>

<script>
    const carousel = document.querySelector(".carousel") as HTMLElement;
    let index = 0;
    let intervalId: number | undefined;

    const startScrolling = () => {
        if (!intervalId && carousel) {
            intervalId = window.setInterval(() => {
                const items = carousel.querySelectorAll(".carousel-item");
                if (items.length > 0) {
                    index = (index + 1) % items.length;

                    // GET THE TARGET ITEM
                    const targetItem = items[index] as HTMLElement;

                    // CALCULATE THE SCROLL POSITION
                    // This moves the "left" edge of the carousel to the "left" edge of the item
                    carousel.scrollTo({
                        left: targetItem.offsetLeft,
                        behavior: "smooth",
                    });
                }
            }, 6000);
        }
    };

    const stopScrolling = () => {
        if (intervalId) {
            clearInterval(intervalId);
            intervalId = undefined;
        }
    };

    if (carousel) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) startScrolling();
                    else stopScrolling();
                });
            },
            { threshold: 0.1 },
        );

        observer.observe(carousel);
    }
</script>
