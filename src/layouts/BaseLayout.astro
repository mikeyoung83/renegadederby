---
// BaseLayout.astro
// Wraps every page: document shell, SEO tags, fonts, Navbar, Footer.
//
//   <BaseLayout title="About Us" description="...">
//
// SEO: title and description are required props (enforced by `astro check`,
// which is chained into `npm run build` — omit either and the build fails).
// ogImage is optional; when omitted, no Open Graph image tags are rendered.
// noindex is an escape hatch for pages that shouldn't be indexed.
// texture adds the decorative comic-book corner (PageTexture) behind the
// page content. It's on by default for interior pages; the homepage passes
// texture={false}.

import { Font } from "astro:assets";
import { SEO } from "astro-seo";
import Navbar from "../components/Navbar.astro";
import PageTexture from "../components/PageTexture.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    siteName?: string;
    lang?: string;
    ogImage?: string;
    noindex?: boolean;
    texture?: boolean;
}

const {
    title,
    description,
    siteName = "Renegade Derby Dames",
    lang = "en",
    ogImage,
    noindex,
    texture = true,
} = Astro.props;

const pageTitle = `${title} · ${siteName}`;
const openGraph = ogImage
    ? {
          basic: { title: pageTitle, type: "website", image: ogImage },
          optional: { description, siteName },
      }
    : undefined;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <SEO
            title={pageTitle}
            description={description}
            noindex={noindex}
            openGraph={openGraph}
        />

        <Font cssVariable="--font-heading-family" preload />
    </head>
    <body class="flex min-h-screen flex-col">
        <a
            href="#main-content"
            class="btn btn-secondary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100"
        >
            Skip to content
        </a>

        <Navbar />

        <main id="main-content" class:list={["grow", texture && "relative isolate"]}>
            {texture && <PageTexture />}
            <slot />
        </main>

        <Footer />
    </body>
</html>
