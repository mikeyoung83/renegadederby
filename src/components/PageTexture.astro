---
// PageTexture.astro
// Decorative comic-book corner: faint white halftone dots (bright) under
// sunburst rays (secondary, league green), faded out from the top-right
// corner.
// Purely visual: hidden from assistive tech and never catches clicks.
//
// Rendered by BaseLayout as the first child of <main>, which becomes
// `relative isolate` so the texture sits behind the page content. Pages
// opt out with <BaseLayout texture={false}>.
//
// The halftone (public/textures/halftone.svg: tiny dots at the corner,
// growing outward) is a shared mask image, so its ~3,400 dots are
// downloaded once and cached, not repeated in every page.

interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;

// Sunburst: alternating wedges fanning out from just beyond the top-right
// corner of a 1000×800 box, covering the quarter that faces into the page.
const origin = { x: 1040, y: -40 };
const rayCount = 22; // wedges across the quarter; every other one is filled
const reach = 1600;
const start = Math.PI / 2; // pointing straight down
const end = Math.PI; // pointing left
const rays: string[] = [];
for (let i = 0; i < rayCount; i += 2) {
    const a1 = start + ((end - start) * i) / rayCount;
    const a2 = start + ((end - start) * (i + 1)) / rayCount;
    const p = (a: number) =>
        `${(origin.x + Math.cos(a) * reach).toFixed(1)},${(origin.y + Math.sin(a) * reach).toFixed(1)}`;
    rays.push(`${origin.x},${origin.y} ${p(a1)} ${p(a2)}`);
}
---

<div
    aria-hidden="true"
    class:list={[
        "pointer-events-none absolute top-0 right-0 -z-10 h-96 w-full text-secondary sm:h-[40rem] sm:w-[70vw] lg:max-w-4xl",
        // Ellipse sized to the box's left and bottom edges (farthest-side from
        // the corner), fully transparent by 85% so nothing is cut off at either edge.
        "mask-radial-at-top-right mask-radial-farthest-side mask-radial-from-0% mask-radial-to-85%",
        className,
    ]}
>
    <div
        class="absolute inset-0 bg-bright opacity-5 mask-[url(/textures/halftone.svg)] mask-size-[auto_100%] mask-top-right mask-no-repeat sm:mask-cover"
    >
    </div>

    <svg
        class="absolute inset-0 h-full w-full"
        viewBox="0 0 1000 800"
        preserveAspectRatio="xMaxYMin slice"
        xmlns="http://www.w3.org/2000/svg"
    >
        <g fill="currentColor" fill-opacity="0.07">
            {rays.map((points) => <polygon points={points} />)}
        </g>
    </svg>
</div>
