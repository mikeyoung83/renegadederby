---
// Footer.astro
// Standard site footer: brand block plus every page link grouped under
// headings (no dropdowns), then a copyright bar. Links come from
// src/navigation.ts.
import { footerNav, socialLinks } from "../navigation";

interface Props {
    siteName?: string;
}

const { siteName = "Renegade Derby Dames" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral/20 bg-secondary/10 text-base-content">
    <div
        class="footer mx-auto max-w-7xl grid-cols-2 gap-x-8 gap-y-10 px-6 py-12 lg:grid-cols-6 lg:px-8"
    >
        <aside class="col-span-2 flex flex-col gap-3">
            <p class="font-heading text-2xl tracking-wide text-bright uppercase">
                {siteName}
            </p>
            <p class="max-w-xs">
                Simcoe County's first flat-track roller derby league. Est. 2011.
            </p>
            <address class="not-italic">
                Alliston Memorial Arena<br />
                <a
                    class="link link-hover"
                    href="https://maps.app.goo.gl/q8ZVpHfXCDdWeTWK6"
                    target="_blank"
                    rel="noopener noreferrer">49 Nelson St. West, Alliston, Ontario</a
                >
            </address>
            <div class="mt-1 flex gap-4">
                <a
                    href={socialLinks.facebook}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Renegade Derby Dames on Facebook"
                    class="opacity-80 transition-opacity hover:opacity-100"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                        ></path>
                    </svg>
                </a>
                <a
                    href={socialLinks.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Renegade Derby Dames on Instagram"
                    class="opacity-80 transition-opacity hover:opacity-100"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                        ></path>
                    </svg>
                </a>
            </div>
        </aside>

        {
            footerNav.map((group) => (
                <nav aria-label={group.title}>
                    <h2 class="footer-title">{group.title}</h2>
                    <ul class="flex flex-col gap-2">
                        {group.links.map((link) => (
                            <li>
                                <a class="link link-hover" href={link.href}>
                                    {link.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))
        }
    </div>

    <div class="border-t border-neutral/20">
        <p class="mx-auto max-w-7xl px-6 py-6 text-sm text-base-content/70 lg:px-8">
            © {year} {siteName}. All rights reserved.
        </p>
    </div>
</footer>
